{
  "name": "synapse-viz",
  "version": "0.1.0",
  "description": "Real-time Claude agent monitoring dashboard",
  "private": true,
  "type": "module",
  "bin": {
    "synapse": "bin/synapse.mjs"
  },
  "files": [
    "dist/",
    "server/",
    "hooks/",
    "bin/",
    "tsconfig.server.json",
    ".env.example"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint server/ src/",
    "lint:fix": "eslint server/ src/ --fix",
    "format": "prettier --write 'server/**/*.ts' 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'server/**/*.ts' 'src/**/*.{ts,tsx}'",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/make-package.ps1",
    "package:prebuilt": "powershell -ExecutionPolicy Bypass -File scripts/make-package.ps1 -Prebuilt",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md}": ["prettier --write"]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@xyflow/react": "^12.6.0",
    "better-sqlite3": "^11.8.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "nanoid": "^5.1.0",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.3.0",
    "vitest": "^4.0.18"
  }
}
