{
  "name": "synapse-monorepo",
  "version": "0.1.0",
  "description": "Synapse — Interactive Agent Orchestration Dashboard (monorepo)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @synapse-ai/server dev\" \"pnpm --filter @synapse-ai/dashboard dev\"",
    "dev:server": "pnpm --filter @synapse-ai/server dev",
    "dev:client": "pnpm --filter @synapse-ai/dashboard dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @synapse-ai/core build",
    "build:server": "pnpm --filter @synapse-ai/server build",
    "build:dashboard": "pnpm --filter @synapse-ai/dashboard build",
    "start": "pnpm --filter @synapse-ai/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/ apps/",
    "lint:fix": "eslint packages/ apps/ --fix",
    "format": "prettier --write 'packages/**/*.ts' 'apps/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'packages/**/*.ts' 'apps/**/*.{ts,tsx}'",
    "clean": "pnpm -r clean"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md}": ["prettier --write"]
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  }
}
