# Web Push Notifications (Phase B)
# Generate keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:dev@localhost

# HTTPS / TLS (required for push notifications on LAN IP)
# Generate certs: mkcert 192.168.x.x localhost 127.0.0.1 ::1
# SYNAPSE_TLS_CERT=./192.168.1.214+3.pem
# SYNAPSE_TLS_KEY=./192.168.1.214+3-key.pem
