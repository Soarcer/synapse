{
  "name": "@synapse-ai/core",
  "version": "0.1.0",
  "description": "Shared types, validation schemas, and utilities for Synapse",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
