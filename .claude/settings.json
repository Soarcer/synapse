{
  "permissions": {
    "allow": [
      "Bash(xxd:*)",
      "Bash(npx eslint:*)",
      "Bash(test:*)",
      "WebFetch(domain:docs.openclaw.ai)",
      "WebFetch(domain:openclaw.ai)",
      "WebFetch(domain:open-claw.bot)",
      "WebFetch(domain:clawhub.ai)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs",
            "async": true
          },
          {
            "type": "http",
            "url": "http://localhost:27247/api/hooks/permission",
            "timeout": 1800
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/send_event.cjs"
          }
        ]
      }
    ]
  }
}
