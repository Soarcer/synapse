{
  "name": "synapse-vscode",
  "displayName": "Synapse — Agent Monitor",
  "description": "Real-time Claude agent monitoring dashboard inside VS Code",
  "version": "0.1.0",
  "publisher": "Soarcer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.claude/settings.json",
    "workspaceContains:.claude/settings.local.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "synapse.openDashboard",
        "title": "Synapse: Open Dashboard"
      },
      {
        "command": "synapse.startServer",
        "title": "Synapse: Start Server"
      },
      {
        "command": "synapse.stopServer",
        "title": "Synapse: Stop Server"
      },
      {
        "command": "synapse.configureHooks",
        "title": "Synapse: Configure Hooks for This Project"
      },
      {
        "command": "synapse.removeHooks",
        "title": "Synapse: Remove Hooks from This Project"
      },
      {
        "command": "synapse.switchLens",
        "title": "Synapse: Switch Lens View"
      },
      {
        "command": "synapse.reconnect",
        "title": "Synapse: Reconnect to Server"
      },
      {
        "command": "synapse.openSettings",
        "title": "Synapse: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "synapse.sendToClaudeTerminal",
        "title": "Synapse: Send Text to Claude Terminal"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "synapse.openSettings",
          "when": "view == synapseSidebarView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "synapseSidebar",
          "title": "Synapse",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "synapseExplorer",
          "name": "Synapse Agents",
          "when": "synapse.serverRunning"
        }
      ],
      "synapseSidebar": [
        {
          "type": "webview",
          "id": "synapseSidebarView",
          "name": "Synapse Dashboard"
        }
      ]
    },
    "configuration": {
      "title": "Synapse",
      "properties": {
        "synapse.port": {
          "type": "number",
          "default": 4000,
          "description": "Preferred port for the Synapse server. If busy, the next available port is used automatically."
        },
        "synapse.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start server when opening a project with Claude hooks"
        },
        "synapse.layout": {
          "type": "string",
          "enum": ["split", "single"],
          "default": "split",
          "description": "Dashboard layout in VS Code",
          "enumDescriptions": [
            "Lenses in the sidebar, graph in a separate editor panel",
            "Full dashboard in a single editor panel"
          ]
        },
        "synapse.animationSpeed": {
          "type": "string",
          "enum": ["off", "slow", "normal", "fast"],
          "default": "normal",
          "description": "Speed of edge and node animations in the graph"
        },
        "synapse.defaultLens": {
          "type": "string",
          "enum": ["tree", "heat", "tmap", "flow", "comp", "cost"],
          "default": "tree",
          "description": "Default lens view when opening the sidebar"
        },
        "synapse.nodeLabelDensity": {
          "type": "string",
          "enum": ["minimal", "normal", "verbose"],
          "default": "normal",
          "description": "Amount of detail shown on graph nodes"
        },
        "synapse.edgeStyle": {
          "type": "string",
          "enum": ["smoothstep", "bezier", "straight"],
          "default": "smoothstep",
          "description": "Edge routing style in the graph"
        },
        "synapse.autoZoom": {
          "type": "string",
          "enum": ["fit-all", "follow-latest", "manual"],
          "default": "fit-all",
          "description": "Auto-zoom behavior when new nodes appear"
        },
        "synapse.themeOverride": {
          "type": "string",
          "enum": ["auto", "dark", "light"],
          "default": "auto",
          "description": "Override the dashboard theme (auto follows VS Code theme)"
        },
        "synapse.maxEvents": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum events to retain in the database (0 = unlimited)"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:ext-only": "node esbuild.mjs --skip-server",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package --no-dependencies",
    "prepackage": "node esbuild.mjs",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('resources'))fs.rmSync('resources',{recursive:true}); if(fs.existsSync('out'))fs.rmSync('out',{recursive:true})\""
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "ws": "^8.18.0",
    "@vscode/vsce": "^3.0.0"
  }
}
