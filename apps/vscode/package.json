{
  "name": "synapse-vscode",
  "displayName": "Synapse — Agent Monitor",
  "description": "Real-time Claude agent monitoring dashboard inside VS Code",
  "version": "0.6.0",
  "publisher": "Soarcer",
  "license": "AGPL-3.0-only",
  "icon": "synapse-icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.claude/settings.json",
    "workspaceContains:.claude/settings.local.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "synapse.openDashboard",
        "title": "Synapse: Open Dashboard"
      },
      {
        "command": "synapse.startServer",
        "title": "Synapse: Start Server"
      },
      {
        "command": "synapse.stopServer",
        "title": "Synapse: Stop Server"
      },
      {
        "command": "synapse.configureHooks",
        "title": "Synapse: Configure Hooks for This Project"
      },
      {
        "command": "synapse.removeHooks",
        "title": "Synapse: Remove Hooks from This Project"
      },
      {
        "command": "synapse.switchLens",
        "title": "Synapse: Switch Lens View"
      },
      {
        "command": "synapse.reconnect",
        "title": "Synapse: Reconnect to Server"
      },
      {
        "command": "synapse.openSettings",
        "title": "Synapse: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "synapse.sendToClaudeTerminal",
        "title": "Synapse: Send Text to Claude Terminal"
      },
      {
        "command": "synapse.improveTextDev",
        "title": "Synapse: Improve Selection (Developer)"
      },
      {
        "command": "synapse.improveTextVibe",
        "title": "Synapse: Improve Selection (Vibe)"
      }
    ],
    "keybindings": [
      {
        "command": "synapse.improveTextDev",
        "key": "ctrl+alt+d"
      },
      {
        "command": "synapse.improveTextVibe",
        "key": "ctrl+alt+v"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "synapse.openSettings",
          "when": "view == synapseSidebarView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "synapseSidebar",
          "title": "Synapse",
          "icon": "synapse-icon-black-128.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "synapseExplorer",
          "name": "Synapse Agents",
          "when": "synapse.serverRunning"
        }
      ],
      "synapseSidebar": [
        {
          "type": "webview",
          "id": "synapseSidebarView",
          "name": "Synapse Dashboard"
        }
      ]
    },
    "configuration": {
      "title": "Synapse",
      "properties": {
        "synapse.host": {
          "type": "string",
          "default": "localhost",
          "description": "Hostname the Synapse server binds to."
        },
        "synapse.port": {
          "type": "number",
          "default": 4000,
          "description": "Preferred port for the Synapse server. If busy, the next available port is used automatically."
        },
        "synapse.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start server when opening a project with Claude hooks"
        },
        "synapse.layout": {
          "type": "string",
          "enum": ["split", "single"],
          "default": "split",
          "description": "Dashboard layout in VS Code",
          "enumDescriptions": [
            "Lenses in the sidebar, graph in a separate editor panel",
            "Full dashboard in a single editor panel"
          ]
        },
        "synapse.promptLab.model": {
          "type": "string",
          "enum": [
            "claude-haiku-4-5-20251001",
            "claude-sonnet-4-5-20250929",
            "claude-opus-4-6"
          ],
          "enumDescriptions": [
            "Haiku 4.5 — fast, cheap",
            "Sonnet 4.5 — balanced",
            "Opus 4.6 — highest quality"
          ],
          "default": "claude-sonnet-4-5-20250929",
          "description": "Default AI model for Prompt Lab hotkeys"
        },
        "synapse.promptLab.showScore": {
          "type": "boolean",
          "default": true,
          "description": "Show score in status bar after processing"
        },
        "synapse.promptLab.maxChars": {
          "type": "number",
          "default": 4000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum characters to send for analysis"
        },
        "synapse.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code notifications when Claude sessions need attention"
        },
        "synapse.notifications.sound": {
          "type": "boolean",
          "default": false,
          "description": "Play a sound when a notification arrives (uses VS Code warning notification)"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:ext-only": "node esbuild.mjs --skip-server",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "prepackage": "node esbuild.mjs",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('resources'))fs.rmSync('resources',{recursive:true}); if(fs.existsSync('out'))fs.rmSync('out',{recursive:true})\""
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "ws": "^8.18.0",
    "@vscode/vsce": "^3.0.0"
  }
}
